{
  "name": "caldova-pharmacy-application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build:services && npm run build --workspace @caldova/portal",
    "build:services": "tsc -b packages/contracts packages/platform apps/risk apps/orders apps/gateway",
    "clean": "tsc -b --clean && npm run clean --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace @caldova/gateway",
    "dev:orders": "npm run dev --workspace @caldova/orders",
    "dev:portal": "npm run dev --workspace @caldova/portal",
    "dev:risk": "npm run dev --workspace @caldova/risk",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && npm run typecheck --workspace @caldova/portal"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.12"
  }
}
